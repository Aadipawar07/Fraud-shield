import React, { useEffect, useState } from "react";
import {
  View,
  ScrollView,
  StyleSheet,
  Image,
  TextInput as RNTextInput,
  TouchableOpacity,
} from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { useRouter } from "expo-router";
import { MaterialIcons, FontAwesome5 } from "@expo/vector-icons";
import { useAuth } from "../../context/AuthContext";
import { ThemedView } from "../../components/ThemedView";
import { ThemedText } from "../../components/ThemedText";
import Button from "../../components/Button";
import Input from "../../components/Input";
import { Card, TouchableCard } from "../../components/Card";
import { Spacing } from "../../constants/Spacing";
import { BorderRadius } from "../../constants/Shape";
import { useTheme } from "../../context/ThemeContext";
import { useThemeColor } from "../../hooks/useThemeColor";

const HomeScreen = () => {
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const { user, isLoggedIn, loading, logout } = useAuth();
  const { colorScheme } = useTheme();
  
  // Get theme colors
  const tintColor = useThemeColor({}, "tint");
  const textColor = useThemeColor({}, "text");
  const cardColor = useThemeColor({}, "card");
  const backgroundColor = useThemeColor({}, "background");
  const backgroundSecondary = useThemeColor({}, "backgroundSecondary");
  
  const [searchText, setSearchText] = useState("");
  
  // Redirect to login if not authenticated
  useEffect(() => {
    if (!loading && !isLoggedIn) {
      router.replace('/sign-in');
    }
  }, [isLoggedIn, loading, router]);

  const handleSignOut = async () => {
    try {
      await logout();
      router.replace("/sign-in");
    } catch (error) {
      console.error("Sign out error:", error);
    }
  };

  // Don't render the main content until we have user data
  if (loading || !user) {
    return (
      <ThemedView style={styles.loadingContainer} center>
        <ThemedText variant="h4">Loading...</ThemedText>
      </ThemedView>
    );
  }

  return (
    <ScrollView
      style={[styles.container, { paddingTop: insets.top + Spacing.md }]}
      contentContainerStyle={styles.content}
      showsVerticalScrollIndicator={false}
    >
      {/* Header Section */}
      <ThemedView style={styles.headerSection}>
        <View style={styles.userInfo}>
          <ThemedText variant="bodyMedium" secondary>Hello,</ThemedText>
          <ThemedText variant="h3" weight="bold" style={styles.userName}>
            {user?.displayName || 'User'}
          </ThemedText>
          <ThemedText variant="bodyMedium" secondary>
            Welcome to Fraud Shield
          </ThemedText>
        </View>
        
        <TouchableOpacity 
          style={styles.profileButton} 
          onPress={() => router.push("/profile")}
        >
          {user?.photoURL ? (
            <Image source={{ uri: user.photoURL }} style={styles.profileImage} />
          ) : (
            <ThemedView 
              style={styles.profileImagePlaceholder}
              lightColor={backgroundSecondary}
              center
            >
              <MaterialIcons name="person" size={28} color={tintColor} />
            </ThemedView>
          )}
        </TouchableOpacity>
      </ThemedView>

      {/* Search Input */}
      <ThemedView style={styles.searchSection}>
        <Input
          placeholder="Search messages or advisors..."
          leftIcon={<MaterialIcons name="search" size={24} color={tintColor} />}
          value={searchText}
          onChangeText={setSearchText}
          variant="filled"
          containerStyle={styles.searchContainer}
        />
      </ThemedView>

      {/* Security Stats Section */}
      <ThemedView style={styles.section}>
        <ThemedText variant="h5" style={styles.sectionTitle}>Security Status</ThemedText>
        
        <View style={styles.statsContainer}>
          {/* Protection Score */}
          <Card variant="flat" style={[styles.statsCard, styles.protectionCard]}>
            <View style={styles.statsIconContainer}>
              <MaterialIcons name="security" size={24} color="#2e7d32" />
            </View>
            <ThemedText variant="h2" weight="bold" style={styles.statsNumber}>
              95%
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.statsLabel}>
              Protection Score
            </ThemedText>
          </Card>

          {/* Alerts */}
          <Card variant="flat" style={[styles.statsCard, styles.alertsCard]}>
            <View style={styles.statsIconContainer}>
              <MaterialIcons name="notifications" size={24} color="#f57c00" />
            </View>
            <ThemedText variant="h2" weight="bold" style={styles.statsNumber}>
              31
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.statsLabel}>
              Alerts
            </ThemedText>
          </Card>

          {/* Actions */}
          <Card variant="flat" style={[styles.statsCard, styles.actionsCard]}>
            <View style={styles.statsIconContainer}>
              <MaterialIcons name="pending-actions" size={24} color="#1976d2" />
            </View>
            <ThemedText variant="h2" weight="bold" style={styles.statsNumber}>
              3
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.statsLabel}>
              Actions Required
            </ThemedText>
          </Card>
        </View>
      </ThemedView>

      {/* Quick Actions */}
      <ThemedView style={styles.section}>
        <ThemedText variant="h5" style={styles.sectionTitle}>Quick Actions</ThemedText>
        
        <View style={styles.quickActionsContainer}>
          <Button
            title="Scan Now"
            leftIcon={<MaterialIcons name="search" size={20} color="#fff" />}
            onPress={() => router.push("/scan")}
            style={styles.quickActionButton}
            size="large"
            fullWidth
          />
        </View>
      </ThemedView>

      {/* Recent Activity */}
      <ThemedView style={styles.section}>
        <View style={styles.sectionHeader}>
          <ThemedText variant="h5" style={styles.sectionTitle}>Recent Activity</ThemedText>
          <TouchableOpacity onPress={() => router.push("/activity")}>
            <ThemedText variant="bodySmall" style={styles.seeAllLink}>See all</ThemedText>
          </TouchableOpacity>
        </View>
        
        <Card style={styles.activityCard}>
          <TouchableOpacity style={styles.activityItem}>
            <View style={[styles.activityIcon, styles.warningIcon]}>
              <MaterialIcons name="warning" size={20} color="#f59e0b" />
            </View>
            <View style={styles.activityContent}>
              <ThemedText variant="bodyMedium" weight="semibold">
                Suspicious SMS detected
              </ThemedText>
              <ThemedText variant="bodySmall" secondary>
                10 minutes ago
              </ThemedText>
            </View>
            <MaterialIcons name="chevron-right" size={24} color={textColor} />
          </TouchableOpacity>
          
          <View style={styles.divider} />
          
          <TouchableOpacity style={styles.activityItem}>
            <View style={[styles.activityIcon, styles.successIcon]}>
              <MaterialIcons name="check-circle" size={20} color="#10b981" />
            </View>
            <View style={styles.activityContent}>
              <ThemedText variant="bodyMedium" weight="semibold">
                Weekly scan completed
              </ThemedText>
              <ThemedText variant="bodySmall" secondary>
                3 hours ago
              </ThemedText>
            </View>
            <MaterialIcons name="chevron-right" size={24} color={textColor} />
          </TouchableOpacity>
        </Card>
      </ThemedView>

      {/* Features */}
      <ThemedView style={styles.section}>
        <ThemedText variant="h5" style={styles.sectionTitle}>Key Features</ThemedText>
        
        <View style={styles.featuresGrid}>
          <TouchableCard
            onPress={() => router.push("/(tabs)/monitor")}
            style={styles.featureCard}
            variant="elevated"
          >
            <View style={[styles.featureIconContainer, styles.monitorIconBg]}>
              <MaterialIcons name="sms" size={24} color="#2563eb" />
            </View>
            <ThemedText variant="bodyMedium" weight="semibold" style={styles.featureText}>
              Monitor SMS
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.featureDescription}>
              Real-time SMS monitoring
            </ThemedText>
          </TouchableCard>

          <TouchableCard
            onPress={() => router.push("/(tabs)/report")}
            style={styles.featureCard}
            variant="elevated"
          >
            <View style={[styles.featureIconContainer, styles.reportIconBg]}>
              <FontAwesome5 name="flag" size={20} color="#dc2626" />
            </View>
            <ThemedText variant="bodyMedium" weight="semibold" style={styles.featureText}>
              Reports
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.featureDescription}>
              Report fraud attempts
            </ThemedText>
          </TouchableCard>

          <TouchableCard
            onPress={() => router.push("/(tabs)/verify")}
            style={styles.featureCard}
            variant="elevated"
          >
            <View style={[styles.featureIconContainer, styles.verifyIconBg]}>
              <MaterialIcons name="verified-user" size={24} color="#16a34a" />
            </View>
            <ThemedText variant="bodyMedium" weight="semibold" style={styles.featureText}>
              Verify
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.featureDescription}>
              Verify links & messages
            </ThemedText>
          </TouchableCard>
          
          <TouchableCard
            onPress={() => router.push("/(tabs)/learning")}
            style={styles.featureCard}
            variant="elevated"
          >
            <View style={[styles.featureIconContainer, styles.learningIconBg]}>
              <MaterialIcons name="school" size={24} color="#8b5cf6" />
            </View>
            <ThemedText variant="bodyMedium" weight="semibold" style={styles.featureText}>
              Learning
            </ThemedText>
            <ThemedText variant="bodySmall" secondary style={styles.featureDescription}>
              Fraud prevention tips
            </ThemedText>
          </TouchableCard>
        </View>
      </ThemedView>

      {/* Alert Banner */}
      <Card 
        variant="flat" 
        style={styles.alertBanner}
      >
        <View style={styles.alertContent}>
          <MaterialIcons name="warning" size={24} color="#92400e" style={styles.alertIcon} />
          <View>
            <ThemedText variant="bodyMedium" weight="semibold" style={styles.alertTitle}>
              Suspicious SMS Detected
            </ThemedText>
            <ThemedText variant="bodySmall" style={styles.alertText}>
              "Your KYC is expiring, click this link..."
            </ThemedText>
          </View>
        </View>
        <Button 
          title="Review" 
          size="small" 
          variant="outline"
          onPress={() => router.push("/(tabs)/monitor")}
        />
      </Card>
    </ScrollView>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
  },
  content: {
    padding: Spacing.lg,
    paddingBottom: Spacing.xxl,
  },
  loadingContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
  },
  headerSection: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: Spacing.lg,
  },
  userInfo: {
    flex: 1,
  },
  userName: {
    marginVertical: Spacing.xs,
  },
  profileButton: {
    marginLeft: Spacing.md,
  },
  profileImage: {
    width: 50,
    height: 50,
    borderRadius: 25,
  },
  profileImagePlaceholder: {
    width: 50,
    height: 50,
    borderRadius: 25,
  },
