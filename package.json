    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "expo": "^53.0.22",
    "expo-background-fetch": "^13.1.6",
    "expo-clipboard": "^7.1.5",
    "expo-linking": "~7.1.7",
    "expo-router": "^5.1.6",
    "expo-task-manager": "^13.1.6",
    "express": "^5.1.0",
    "firebase": "^12.1.0",
    "openai": "^5.15.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-android-sms-listener": "^0.8.0",
    "react-native-web": "^0.20.0"
  },
