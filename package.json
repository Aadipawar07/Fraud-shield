{
  "name": "fraud-shield",
  "version": "1.0.0",
  "description": "",
  "main": "frontend/my-app/index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node backend/index.js",
    "backend": "node backend/index.js",
    "frontend": "cd frontend/my-app && npx expo start --clear",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "expo": "cd frontend/my-app && npx expo start --clear",
    "android": "cd frontend/my-app && npx expo run:android",
    "ios": "cd frontend/my-app && npx expo run:ios",
    "build:apk": "cd frontend/my-app && npm run prepare-sms-monitoring && npx eas build --platform android --profile preview",
    "build:dev-apk": "cd frontend/my-app && npm run prepare-sms-monitoring && npx eas build --platform android --profile development",
    "export": "cd frontend/my-app && npx expo export -p android",
    "deploy": "cd frontend/my-app && eas deploy",
    "export-deploy": "cd frontend/my-app && npx expo export -p android && eas deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aadipawar07/Fraud-shield-.git"
  },
